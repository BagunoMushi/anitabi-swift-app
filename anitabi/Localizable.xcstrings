      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Comparison"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の比較"
          }
        }
      }
    },
    "%@访问受限": {
