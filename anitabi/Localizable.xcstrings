      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spot data comes from the anitabi.cn community, used under CC BY-NC-SA 4.0. Screenshots and titles remain the property of their rights holders and appear here only for scene comparison."
